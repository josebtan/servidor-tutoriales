# =============================================================================
# UNITYCRAFT BACKEND API — CONFIGURACIÓN DE ENTORNO (.env)
# =============================================================================
PORT=4000
ALLOWED_ORIGIN=https://josebtan.github.io

# Conexión MySQL Compartida con el Servidor de Minecraft (ElixirNode Database)
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=u_unitycraft
DB_PASS=tu_password_mysql
DB_NAME=s_unitycraft

# Conexión Directa a Consola de ElixirNode (Pterodactyl Client API)
# Se genera en: https://game.elixirnode.com/account/api
PTERO_PANEL_URL=https://game.elixirnode.com
PTERO_SERVER_ID=8b9cfa7f
PTERO_CLIENT_API_KEY=ptlc_tu_api_key_de_elixirnode

# Secreto HMAC para Webhooks de Pasarela de Pago (Stripe / Tebex / MercadoPago)
PAYMENT_WEBHOOK_SECRET=whsec_tu_secreto_hmac
